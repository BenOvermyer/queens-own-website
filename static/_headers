# Security headers for every response. script-src is 'none' because the site
# ships no JavaScript; style-src allows 'unsafe-inline' only because preserved
# pages still carry inline style attributes (see the legacy-markup work) and it
# can be dropped once those are gone. www.queensown.org is allowed for images
# and fonts so pages served from a preview or branch hostname can still reach
# assets baked against the canonical base_url.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://www.queensown.org; style-src 'self' 'unsafe-inline'; font-src 'self' https://www.queensown.org; script-src 'none'; object-src 'none'; form-action 'none'; base-uri 'self'; frame-ancestors 'none'

# Self-hosted fonts are immutable for a given filename, so cache them for a
# year. Web fonts are always fetched in CORS mode by the browser, even for
# same-origin preloads. Netlify serves the site from several hostnames
# (custom domain, branch and deploy-preview aliases), so a page fetched from
# one hostname can request fonts from the origin baked into base_url. Allow
# those requests instead of letting the browser block the response.
/fonts/*
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

# Static assets rarely change under a given filename; cache them for a year.
# If an asset is ever replaced in place, rename it so returning visitors pick
# up the new copy.
/css/*
  Cache-Control: public, max-age=31536000

/images/*
  Cache-Control: public, max-age=31536000

/icons/*
  Cache-Control: public, max-age=31536000
